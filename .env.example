# Required. The course entry page shown in the browser.
COURSE_URL=https://moocs.unipus.cn/my/course/8021

# Browser. Use the installed Google Chrome by default.
BROWSER_CHANNEL=chrome
# BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
HEADLESS=false
SLOW_MO=0
# Keep login cookies and the same browser identity between runs.
USER_DATA_DIR=.browser-profile

# Login and navigation timeouts.
LOGIN_WAIT_TIMEOUT_MS=900000
NAVIGATION_TIMEOUT_MS=60000
VIDEO_WAIT_TIMEOUT_MS=60000
POLL_INTERVAL_MS=3000

# Playback. Keep 1 by default so the platform sees ordinary playback.
PLAYBACK_RATE=1
MUTE_VIDEO=true
SKIP_COMPLETED=true

# A task is clicked only when the page identifies it as video content.
TASK_SELECTOR=a[href*="task"],a[href*="/courseware/"],a[href*="/lesson/"]
VIDEO_KEYWORDS=videoclass,video,视频,观看
EXCLUDE_KEYWORDS=zuoye,assignment,homework,exam,quiz,test,作业,测验,考试,讨论,问答
COMPLETED_KEYWORDS=iccheckcircleblack24px,completed,finished,已完成

# Safety fallback: set true only if every task in the course is a video.
ASSUME_ALL_TASKS_ARE_VIDEO=false

# Stop a single video after this many minutes. 0 disables the cap.
VIDEO_MAX_WATCH_MINUTES=240

# For selector testing: npm start -- --dry-run
KEEP_BROWSER_OPEN=false
